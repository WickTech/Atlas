# All keys are optional — every source falls back gracefully without them.
# Set these in Vercel → Project → Settings → Environment Variables, then REDEPLOY
# (Vercel applies environment changes only to new deployments). Never commit real values.

# Alpha Vantage (free key): per-article news sentiment (Market Mood, Top Driver) and the top gainer.
# Free tier = 25 requests/day AND 1 request/second, so Atlas spaces its two calls apart and
# reuses the result for 3 hours (retrying a failed call after 20 minutes).
ALPHA_VANTAGE_API_KEY=

# AI briefings (/api/briefing, /api/brief): Groq is tried first, then OpenRouter, then a
# deterministic rule-based digest. Exact variable names matter (e.g. OPENROUTER_KEY is ignored).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# How long (milliseconds) the assembled /api/metrics payload is reused per instance.
METRICS_TTL_MS=60000

# Overrides for the upstream endpoints (leave unset to use the defaults in src/server/).
GDELT_BASE=
GDELT_QUERY=
YF_BASE=
